# --- Existing app settings ---
SECRET_KEY=change-me
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ADMIN_EMAIL=
KIOSK_PASSWORD=

# --- SMTP (mentor absence reminders) ---
# Reminders are disabled until SMTP_HOST, SMTP_USER and SMTP_PASSWORD are all set.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=your-app-password
# starttls (port 587), ssl (port 465), or none
SMTP_SECURITY=starttls

# Custom sender name shown in the "From" field
SMTP_FROM_NAME=Robotics Attendance
# Optional: defaults to SMTP_USER
SMTP_FROM_EMAIL=

# How many hours before a session start the email goes out
REMINDER_HOURS_BEFORE=6
# Set to true to email mentors even when nobody reported an absence
REMINDER_SEND_IF_NO_ABSENCES=false
